# Copy to config.properties and add your private API keys.
# Never commit config.properties or share it publicly.
virustotal.api.key=PASTE_VIRUSTOTAL_API_KEY_HERE

http.timeout.seconds=5
max.retries=2

# AI Analysis provider: auto | opencode | openai-compatible
# auto keeps OpenCode as primary and falls back to the OpenAI-compatible provider.
# OpenCode is preserved; it owns its own credentials in OpenCode's auth store.
# Optional backend overrides (defaults discover the local service registration):
# ai.opencode.url=http://127.0.0.1:4096
# ai.opencode.service-file=C:/Users/<you>/.local/state/opencode/service.json
# ai.opencode.model=opencode/big-pickle

# Free Groq fallback (OpenAI-compatible). Get a key at https://console.groq.com/keys
# and put it ONLY in config.properties or GROQ_API_KEY in the backend environment.
ai.provider=openai-compatible
ai.openai.base.url=https://api.groq.com/openai/v1
ai.openai.model=openai/gpt-oss-20b
ai.openai.api.key=PASTE_GROQ_API_KEY_HERE

# ai.timeout.seconds=60
