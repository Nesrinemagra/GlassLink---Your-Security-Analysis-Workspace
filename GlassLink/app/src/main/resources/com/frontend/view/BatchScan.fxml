<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

                                                                                                      
<VBox spacing="10.0" styleClass="tab-page" stylesheets="@../css/batch.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.frontend.controller.BatchScanController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label styleClass="card-title" text="Evaluation results"/>
            <Label fx:id="resultCountLabel" styleClass="count-pill" text="0 items"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="fileInfoLabel" styleClass="file-info" text="No file loaded"/>
            <Button fx:id="loadCsvButton" mnemonicParsing="false" onAction="#handleLoadCsv"
                    styleClass="button-secondary" text="Load CSV..."/>
            <Button fx:id="clearResultsButton" mnemonicParsing="false" onAction="#handleClearResults"
                    styleClass="button-ghost" text="Clear results"/>
         </children>
      </HBox>
      <TableView fx:id="resultsTable" minHeight="90.0" prefHeight="260.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="numberColumn" maxWidth="70.0" minWidth="50.0" prefWidth="60.0" text="#"/>
            <TableColumn fx:id="typeColumn" maxWidth="130.0" minWidth="80.0" prefWidth="100.0" text="Type"/>
            <TableColumn fx:id="inputColumn" minWidth="160.0" prefWidth="460.0" text="Input"/>
            <TableColumn fx:id="statusColumn" maxWidth="190.0" minWidth="120.0" prefWidth="150.0" text="Status"/>
            <TableColumn fx:id="riskColumn" maxWidth="190.0" minWidth="120.0" prefWidth="150.0" text="Risk"/>
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
         </columnResizePolicy>
         <placeholder>
            <VBox alignment="CENTER" spacing="6.0" styleClass="empty-state">
               <children>
                  <Label styleClass="empty-title" text="No evaluations yet"/>
                  <Label styleClass="empty-text"
                         text="Load a CSV file to scan many URLs or messages at once."/>
               </children>
            </VBox>
         </placeholder>
      </TableView>

                                          
      <VBox minHeight="150.0" prefHeight="150.0" maxHeight="150.0" spacing="8.0" styleClass="card">
         <children>
            <Label styleClass="card-title" text="Details"/>
            <StackPane styleClass="details-box" VBox.vgrow="ALWAYS">
               <children>
                  <VBox fx:id="detailsEmptyState" alignment="CENTER" spacing="4.0">
                     <children>
                        <Label styleClass="empty-title" text="Select a row to see its analysis details."/>
                        <Label styleClass="empty-text"
                               text="Detection reasons and verification errors will appear here."/>
                     </children>
                  </VBox>
                  <GridPane fx:id="detailsGrid" hgap="12.0" vgap="6.0" managed="false" visible="false"
                            StackPane.alignment="TOP_LEFT">
                     <columnConstraints>
                        <ColumnConstraints minWidth="40.0" prefWidth="50.0"/>
                        <ColumnConstraints minWidth="70.0" prefWidth="110.0"/>
                        <ColumnConstraints minWidth="50.0" prefWidth="55.0"/>
                        <ColumnConstraints minWidth="90.0" prefWidth="130.0"/>
                        <ColumnConstraints minWidth="40.0" prefWidth="45.0"/>
                        <ColumnConstraints minWidth="90.0" prefWidth="100.0"/>
                        <ColumnConstraints minWidth="55.0" prefWidth="65.0"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="80.0"/>
                     </columnConstraints>
                     <children>
                        <Label styleClass="detail-key" text="Type" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="detailTypeLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label styleClass="detail-key" text="Status" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label fx:id="detailStatusLabel" styleClass="detail-value" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        <Label styleClass="detail-key" text="Risk" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                        <Label fx:id="detailRiskLabel" styleClass="detail-value" GridPane.columnIndex="5" GridPane.rowIndex="0"/>
                        <Label styleClass="detail-key" text="Duration" GridPane.columnIndex="6" GridPane.rowIndex="0"/>
                        <Label fx:id="detailDurationLabel" styleClass="detail-value" GridPane.columnIndex="7" GridPane.rowIndex="0"/>
                        <Label styleClass="detail-key" text="Input" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="detailInputLabel" styleClass="detail-value" maxWidth="1.7976931348623157E308"
                               GridPane.columnIndex="1" GridPane.columnSpan="7" GridPane.rowIndex="1"/>
                        <Label styleClass="detail-key" text="Notes" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="detailNotesLabel" styleClass="detail-muted" maxWidth="1.7976931348623157E308"
                               GridPane.columnIndex="1" GridPane.columnSpan="7" GridPane.rowIndex="2"/>
                     </children>
                  </GridPane>
               </children>
            </StackPane>
         </children>
      </VBox>

                                          
      <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="batch-progress">
         <children>
            <ProgressBar fx:id="progressBar" prefWidth="260.0" progress="0.0" styleClass="app-progress"/>
            <Label fx:id="progressLabel" styleClass="progress-text" text="Ready"/>
            <Label fx:id="progressCountLabel" styleClass="progress-muted" text="0 of 0 evaluated"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="cancelButton" disable="true" mnemonicParsing="false" onAction="#handleCancel"
                    styleClass="button-secondary" text="Cancel"/>
         </children>
      </HBox>
   </children>
</VBox>
